<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS settings for the SpMS API on Azure App Service (Windows). `dotnet publish`
  adds the aspNetCore handler to this file.

  Dynamic compression is off: IIS would buffer the live board's event stream
  (text/event-stream) to compress it, and the board would receive nothing until
  the buffer filled. The API's JSON is small; the network cost is negligible.
-->
<configuration>
  <system.webServer>
    <urlCompression doStaticCompression="true" doDynamicCompression="false" />
  </system.webServer>
</configuration>
