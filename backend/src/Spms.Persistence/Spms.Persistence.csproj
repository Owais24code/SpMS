<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\Spms.SharedKernel\Spms.SharedKernel.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.7" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.7" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.7">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
  </ItemGroup>
  <ItemGroup>
    <!-- Migration SQL is FROZEN with its migration: Migrations/Sql/<Migration>/*.sql.
         The reference schema (database/schema) keeps evolving from database/model;
         a CI test builds a database both ways and requires them to be identical.
         Roles are cluster-level and come from the reference file directly. -->
    <EmbeddedResource Include="Migrations\Sql\**\*.sql" LogicalName="Spms.Migrations.%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\..\database\schema\000_roles.sql" LogicalName="Spms.Schema.000_roles.sql" />
  </ItemGroup>
</Project>
