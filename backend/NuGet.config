<?xml version="1.0" encoding="utf-8"?>
<!--
  The ordinary restore: nuget.org.

  This file exists so the solution does not inherit a machine-wide
  configuration that may point somewhere else, and so a clean checkout restores
  the same way on a developer's machine and on a CI runner.

  For a machine with no route to nuget.org, NuGet.offline.config restores from
  the package closure in vendor/nuget instead:

      dotnet restore Spms.sln -p:RestoreConfigFile=NuGet.offline.config
      dotnet build   Spms.sln -c Release   (then build without restoring)

  vendor/nuget is deliberately NOT in version control. It is 30 MB of binaries
  reconstructible from any machine that can reach nuget.org, and a repository
  that carries its own package mirror is a repository whose dependencies are
  invisible to every tool that reads a project file.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
