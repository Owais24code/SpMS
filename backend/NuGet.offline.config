<?xml version="1.0" encoding="utf-8"?>
<!--
  The air-gapped restore. Used explicitly, never by default:

      dotnet restore Spms.sln -p:RestoreConfigFile=NuGet.offline.config
      dotnet build   Spms.sln -c Release   (then build without restoring)

  This exists because the environment the Postgres slice was built in cannot
  reach nuget.org — the egress policy answers 403 to CONNECT — so the packages
  were restored from a feed assembled out of a local package cache. It is kept
  because the next such environment should not have to work that out again.

  <clear /> is deliberate: without it a restore that silently fell back to a
  reachable upstream would produce a build nobody could reproduce.

  vendor/nuget is NOT in version control; tools/vendor-nuget.sh rebuilds it from
  a machine that already has the packages in ~/.nuget/packages. Every .nupkg in
  the dependency closure has to be present — a partial feed fails with NU1101,
  naming only the first package it could not find.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="vendored" value="vendor/nuget" />
  </packageSources>
</configuration>
