{
  // Cloudflare Workers static assets.
  //
  // This is the Workers Builds path, not Pages. `npx wrangler deploy` reads
  // this file, so without it the deploy step fails with no config found — the
  // dashboard pre-fills that command but cannot supply the file.
  //
  // There is no "main" entry on purpose: this Worker has no code, only assets.
  // A static-only Worker is valid and is what a built Angular app needs.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spms",
  "compatibility_date": "2026-09-01",

  "assets": {
    // Relative to this file, so the dashboard's Path must be /web for the
    // build output to be where this says it is.
    "directory": "./dist/web/browser",

    // The SPA fallback, and the ONLY mechanism for it here. An unmatched path
    // is served /index.html with a 200 rather than a 404 — the same problem
    // Blob static hosting has, and the reason Front Door needs a rewrite rule
    // there.
    //
    // A public/_redirects carrying `/* /index.html 200` used to sit alongside
    // this. That is the canonical SPA rule on Pages, but Workers REFUSES it:
    // its asset serving already strips `.html` and `/index`, so the rewrite
    // would re-enter its own rule, and the deploy fails validation with
    // "Infinite loop detected in this rule" (code 100324). The file was
    // removed rather than narrowed — this setting already does the job, and a
    // second mechanism for one behaviour is what produced the failure.
    "not_found_handling": "single-page-application"
  }
}
