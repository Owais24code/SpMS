<?xml version="1.0" encoding="utf-8"?>
<!--
  Sources are cleared deliberately. The whole service builds against the
  locally installed Microsoft.AspNetCore.App framework with zero external
  packages, so it restores and builds on a machine with no NuGet access.
  Add a source here when EF Core is introduced.
-->
<configuration>
  <packageSources>
    <clear />
  </packageSources>
</configuration>
