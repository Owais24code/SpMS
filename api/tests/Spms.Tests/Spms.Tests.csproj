  <ItemGroup>
    <ProjectReference Include="..\..\src\Spms.Domain\Spms.Domain.csproj" />
    <ProjectReference Include="..\..\src\Spms.Infrastructure\Spms.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Spms.Api\Spms.Api.csproj" />
  </ItemGroup>
</Project>
