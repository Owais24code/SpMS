<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Sdk.Web so the Api project's framework reference resolves. The Api
         project is referenced deliberately: its guards, problem+json shaping,
         ETag handling and paging were entirely uncovered, and the tenancy
         convention lives in that layer. -->
